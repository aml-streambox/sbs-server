# Copy to .env for local development/deployment overrides.
# .env is intentionally ignored by Git.

# SSH target for scripts/deploy.sh and scripts/validate-runtime.sh.
# Example: TARGET=root@device-hostname.local
TARGET=

# Path to a Yocto checkout, used by scripts/setup-sdk.sh and scripts/sdk-patch.sh.
# Example: YOCTO_ROOT=/path/to/yocto
YOCTO_ROOT=

# Optional direct SDK installer path. If set, YOCTO_ROOT is not required by setup-sdk.sh.
# Example: SDK_SRC=/path/to/sbs-sdk-mesont7c-kvim4-5.15.sh
SDK_SRC=

# Optional path to the standalone JavaScript CLI used by validate-runtime.sh.
# Example: SBS_CLIENT_CLI=sbs-client-cli
SBS_CLIENT_CLI=sbs-client-cli

# Runtime API options for validate-runtime.sh.
SBS_API_PORT=10100
SBS_OUTPUT_ID=default-out
SBS_SOURCE_ID=default-src
