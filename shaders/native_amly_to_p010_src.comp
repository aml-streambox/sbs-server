#version 450

layout(local_size_x = 16, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer SrcAMLY {
    uint data[];
} src;
layout(set = 0, binding = 1, r16) uniform image2D y_img;
layout(set = 0, binding = 2, rg16) uniform image2D uv_img;

layout(push_constant) uniform PushConstants {
    uint canvas_width;
    uint canvas_height;
    int dst_x;
    int dst_y;
    uint dst_w;
    uint dst_h;
    uint src_w;
    uint src_h;
    float opacity;
    uint flags;
    uint y_stride;
    uint src_pair_start;
    uint src_pair_count;
    float y_scale_x;
    float y_scale_y;
    float uv_scale_x;
    float uv_scale_y;
    float bg_y;
    float bg_u;
    float bg_v;
    uint filter_flags;
    float hdr_to_sdr_amount;
    float hdr_saturation;
    float hdr_brightness;
    float hdr_hue_cos;
    float hdr_hue_sin;
} pc;

const uint FILTER_HDR_TO_SDR = 32u;
const uint FILTER_SDR_TO_HDR = 1024u;

uint bswap32(uint val) {
    return ((val & 0x000000FFu) << 24) |
           ((val & 0x0000FF00u) <<  8) |
           ((val & 0x00FF0000u) >>  8) |
           ((val & 0xFF000000u) >> 24);
}

uint corrected_word(uint word_idx) {
    uint base = word_idx & ~1u;
    uint lo = src.data[base];
    uint hi = src.data[base + 1u];
    return ((word_idx & 1u) == 0u) ? bswap32(hi) : bswap32(lo);
}

void read_pair_bits(uint pair_idx, out uint lo, out uint hi) {
    uint byte_offset = pair_idx * 5u;
    uint word_idx = byte_offset >> 2;
    uint shift = (byte_offset & 3u) << 3;
    uint w0 = corrected_word(word_idx);
    uint w1 = corrected_word(word_idx + 1u);
    if (shift == 0u) {
        lo = w0;
        hi = w1 & 0xFFu;
    } else {
        uint w2 = corrected_word(word_idx + 2u);
        lo = (w0 >> shift) | (w1 << (32u - shift));
        hi = ((w1 >> shift) | (w2 << (32u - shift))) & 0xFFu;
    }
}

void decode_pair(uint pair_idx, out uint y0, out uint u, out uint y1, out uint v) {
    uint lo, hi;
    read_pair_bits(pair_idx, lo, hi);
    uint bs = bswap32(lo);
    y0 = (bs >> 22) & 0x3FFu;
    u = (bs >> 12) & 0x3FFu;
    y1 = (bs >> 2) & 0x3FFu;
    v = ((bs & 0x3u) << 8) | hi;
}

uint pairs_per_row() { return max(pc.src_w >> 1, 1u); }

uint out_begin_for_src(uint s, float inv_scale) {
    return uint(max(ceil(float(s) * inv_scale - 0.5), 0.0));
}

uint out_end_for_src(uint s, float inv_scale, uint limit) {
    float end_f = ceil(float(s + 1u) * inv_scale - 0.5);
    return uint(clamp(end_f, 0.0, float(limit)));
}

float hdr_filter_amount() {
    if ((pc.filter_flags & FILTER_SDR_TO_HDR) != 0u)
        return clamp(pc.hdr_to_sdr_amount, 0.0, 2.0);
    if ((pc.filter_flags & FILTER_HDR_TO_SDR) != 0u)
        return clamp(pc.hdr_to_sdr_amount, 0.0, 1.0);
    return 0.0;
}

float tone_map_luma(float y) {
    const float shoulder = 0.24;
    return clamp(((1.0 + shoulder) * y) / (y + shoulder), 0.0, 1.0);
}

float bt709_to_linear(float v) {
    v = clamp(v, 0.0, 1.0);
    return v < 0.081 ? v / 4.5 : pow((v + 0.099) / 1.099, 1.0 / 0.45);
}

float nits_to_pq(float nits) {
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    float p = pow(clamp(nits / 10000.0, 0.0, 1.0), m1);
    return pow((c1 + c2 * p) / (1.0 + c3 * p), m2);
}

float sdr_shadow_lift(float y, float over) {
    return mix(0.010, 0.006, over) *
        (1.0 - smoothstep(0.02, 0.30, clamp(y, 0.0, 1.0)));
}

float sdr_highlight_scale(float y, float over) {
    float t = smoothstep(0.68, 0.98, clamp(y, 0.0, 1.0));
    return mix(1.0, mix(0.68, 0.78, over), t);
}

float sdr_midtone_contrast(float pq, float y, float over) {
    float weight = smoothstep(0.18, 0.42, clamp(y, 0.0, 1.0)) *
        (1.0 - smoothstep(0.72, 0.90, clamp(y, 0.0, 1.0)));
    float contrast = 1.0 + 0.035 * weight * mix(1.0, 0.75, over);
    float pivot = mix(0.420, 0.445, over);
    return pivot + (pq - pivot) * contrast;
}

float sdr_to_hdr_luma(float y, float amount) {
    float over = clamp(amount - 1.0, 0.0, 1.0);
    float white_nits = mix(160.0, 240.0, over);
    float pq = nits_to_pq(bt709_to_linear(y) * white_nits * sdr_highlight_scale(y, over));
    pq = sdr_midtone_contrast(pq, y, over);
    pq += sdr_shadow_lift(y, over);
    pq += clamp(pc.hdr_brightness, -0.3, 0.3) * amount * 0.5;
    return clamp(pq, 0.0, 1.0);
}

vec2 rotate_chroma(vec2 cbcr) {
    return vec2(
        cbcr.x * pc.hdr_hue_cos - cbcr.y * pc.hdr_hue_sin,
        cbcr.x * pc.hdr_hue_sin + cbcr.y * pc.hdr_hue_cos);
}

float map_y10(uint y10) {
    float amount = hdr_filter_amount();
    if (amount <= 0.0)
        return float(y10 << 6) / 65535.0;
    float y = clamp((float(y10) - 64.0) / 876.0, 0.0, 1.0);
    bool sdr_to_hdr = (pc.filter_flags & FILTER_SDR_TO_HDR) != 0u;
    float target = sdr_to_hdr ? sdr_to_hdr_luma(y, amount) : tone_map_luma(y);
    float mapped = mix(y, target, sdr_to_hdr ? min(amount, 1.0) : amount);
    return ((64.0 + mapped * 876.0) * 64.0) / 65535.0;
}

vec2 map_uv10(uint u10, uint v10) {
    float amount = hdr_filter_amount();
    if (amount <= 0.0)
        return vec2(float(u10 << 6), float(v10 << 6)) / 65535.0;
    float cb = (float(u10) - 512.0) / 896.0;
    float cr = (float(v10) - 512.0) / 896.0;
    bool sdr_to_hdr = (pc.filter_flags & FILTER_SDR_TO_HDR) != 0u;
    float over = sdr_to_hdr ? clamp(amount - 1.0, 0.0, 1.0) : 0.0;
    float target_sat = sdr_to_hdr
        ? clamp(pc.hdr_saturation, 0.5, 2.5) * mix(1.0, 1.08, over)
        : 0.82;
    vec2 adjusted = rotate_chroma(vec2(cb, cr) * target_sat);
    vec2 mapped = mix(vec2(cb, cr), adjusted, sdr_to_hdr ? min(amount, 1.0) : amount);
    return ((vec2(512.0) + mapped * 896.0) * 64.0) / 65535.0;
}

void write_luma_rect(uint src_x, uint src_y, float y) {
    float inv_x = 1.0 / pc.y_scale_x;
    float inv_y = 1.0 / pc.y_scale_y;
    uint lx0 = out_begin_for_src(src_x, inv_x);
    uint lx1 = out_end_for_src(src_x, inv_x, pc.dst_w);
    uint ly0 = out_begin_for_src(src_y, inv_y);
    uint ly1 = out_end_for_src(src_y, inv_y, pc.dst_h);

    int visible_lx0 = max(int(lx0), -pc.dst_x);
    int visible_lx1 = min(int(lx1), int(pc.canvas_width) - pc.dst_x);
    int visible_ly0 = max(int(ly0), -pc.dst_y);
    int visible_ly1 = min(int(ly1), int(pc.canvas_height) - pc.dst_y);
    if (visible_lx1 <= visible_lx0 || visible_ly1 <= visible_ly0)
        return;

    for (int ly = visible_ly0; ly < visible_ly1; ly++) {
        int dy = pc.dst_y + ly;
        for (int lx = visible_lx0; lx < visible_lx1; lx++)
            imageStore(y_img, ivec2(pc.dst_x + lx, dy), vec4(y, 0.0, 0.0, 1.0));
    }
}

void write_chroma_rect(uint src_pair_x, uint src_y, vec2 uv) {
    float inv_x = 1.0 / pc.y_scale_x;
    float inv_y = 1.0 / pc.y_scale_y;
    uint lx0 = out_begin_for_src(src_pair_x * 2u, inv_x) & ~1u;
    uint lx1 = (out_end_for_src(src_pair_x * 2u + 1u, inv_x, pc.dst_w) + 1u) & ~1u;
    uint ly0 = out_begin_for_src(src_y, inv_y) & ~1u;
    uint ly1 = (out_end_for_src(src_y, inv_y, pc.dst_h) + 1u) & ~1u;

    int visible_lx0 = max(int(lx0), (-pc.dst_x + 1) & ~1);
    int visible_lx1 = min(int(lx1), (int(pc.canvas_width) - pc.dst_x) & ~1);
    int visible_ly0 = max(int(ly0), (-pc.dst_y + 1) & ~1);
    int visible_ly1 = min(int(ly1), (int(pc.canvas_height) - pc.dst_y) & ~1);
    if (visible_lx1 <= visible_lx0 || visible_ly1 <= visible_ly0)
        return;

    for (int ly = visible_ly0; ly < visible_ly1; ly += 2) {
        int uy = (pc.dst_y + ly) >> 1;
        for (int lx = visible_lx0; lx < visible_lx1; lx += 2)
            imageStore(uv_img, ivec2((pc.dst_x + lx) >> 1, uy), vec4(uv, 0.0, 1.0));
    }
}

void main() {
    uint local_pair = gl_GlobalInvocationID.x;
    uint local_y = gl_GlobalInvocationID.y;

    if (pc.src_h == 0u) {
        if (local_pair >= pc.src_pair_count)
            return;

        uint y = pc.y_stride + local_y * 2u;
        uint x = pc.src_pair_start + local_pair * 2u;
        uint x_end = min(pc.src_pair_start + pc.src_pair_count * 2u, pc.canvas_width);
        if (x >= x_end || y >= pc.canvas_height)
            return;

        imageStore(y_img, ivec2(x, y), vec4(pc.bg_y, 0.0, 0.0, 1.0));
        if (x + 1u < x_end)
            imageStore(y_img, ivec2(x + 1u, y), vec4(pc.bg_y, 0.0, 0.0, 1.0));
        if (y + 1u < pc.canvas_height) {
            imageStore(y_img, ivec2(x, y + 1u), vec4(pc.bg_y, 0.0, 0.0, 1.0));
            if (x + 1u < x_end)
                imageStore(y_img, ivec2(x + 1u, y + 1u), vec4(pc.bg_y, 0.0, 0.0, 1.0));
        }

        uint uv_y = (pc.y_stride >> 1) + local_y;
        uint uv_x = x >> 1;
        if (uv_y < (pc.canvas_height >> 1) && x + 1u < x_end)
            imageStore(uv_img, ivec2(uv_x, uv_y), vec4(pc.bg_u, pc.bg_v, 0.0, 1.0));
        return;
    }

    uint src_y = pc.y_stride + local_y;

    if (local_pair >= pc.src_pair_count || src_y >= pc.src_h)
        return;

    uint pair_x = pc.src_pair_start + local_pair;
    if (pair_x >= pairs_per_row())
        return;

    uint y0, u, y1, v;
    decode_pair(src_y * pairs_per_row() + pair_x, y0, u, y1, v);
    write_luma_rect(pair_x * 2u, src_y, map_y10(y0));
    write_luma_rect(pair_x * 2u + 1u, src_y, map_y10(y1));
    write_chroma_rect(pair_x, src_y, map_uv10(u, v));
}
