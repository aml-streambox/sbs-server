#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D out_img;

layout(std430, set = 0, binding = 1) readonly buffer YUVBuf {
    uint data[];
} yuv_buf;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint y_stride;
    uint uv_stride;
    uint uv_offset;
    uint format;    /* 0 = NV21 (8-bit, VU), 1 = NV12 (8-bit, UV), 2 = P010_10LE (10-bit, UV) */
    uint flags;      /* bit 0: preserve P010 BT.2020/PQ RGB for HDR->SDR filters */
} pc;

const uint YUV_TO_RGBA_PRESERVE_PQ = 1u;

float unpack_byte(uint word, uint byte_idx) {
    return float((word >> (byte_idx * 8u)) & 0xFFu);
}

float pq_to_nits(float v) {
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    float vp = pow(clamp(v, 0.0, 1.0), 1.0 / m2);
    float num = max(vp - c1, 0.0);
    float den = max(c2 - c3 * vp, 0.000001);
    return 10000.0 * pow(num / den, 1.0 / m1);
}

float tonemap_nits(float nits) {
    float x = max(nits, 0.0) / 100.0;
    return x / (1.0 + x);
}

float linear_to_srgb(float v) {
    v = clamp(v, 0.0, 1.0);
    return v <= 0.0031308 ? 12.92 * v : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

uint read_u16(uint byte_addr) {
    uint word = yuv_buf.data[byte_addr >> 2];
    uint byte_in_word = byte_addr & 3u;
    if (byte_in_word == 0u) {
        return word & 0xFFFFu;
    } else {
        return (word >> 16) & 0xFFFFu;
    }
}

void main() {
    uvec2 coord = gl_GlobalInvocationID.xy;
    if (coord.x >= pc.width || coord.y >= pc.height) return;

    float Y, U, V;

    if (pc.format == 2u) {
        /* P010 / 10-bit semi-planar: 16-bit samples, UV order (standard P010_10LE).
         * Treat P010 as HDR10 BT.2020/PQ and tone-map to SDR for the RGBA
         * preview path. The main HDR encoder path reads P010 directly. */
        uint y_byte_addr = coord.y * pc.y_stride + coord.x * 2u;
        uint y_word = read_u16(y_byte_addr);
        float y10 = float((y_word >> 6) & 0x3FFu);

        uint uv_row = coord.y >> 1;
        uint uv_col = coord.x >> 1;
        uint uv_byte_addr = pc.uv_offset + uv_row * pc.uv_stride + uv_col * 4u;
        uint u_word = read_u16(uv_byte_addr);
        uint v_word = read_u16(uv_byte_addr + 2u);
        float u10 = float((u_word >> 6) & 0x3FFu);
        float v10 = float((v_word >> 6) & 0x3FFu);

        float y = clamp((y10 - 64.0) / 876.0, 0.0, 1.0);
        float cb = (u10 - 512.0) / 896.0;
        float cr = (v10 - 512.0) / 896.0;

        vec3 rgb2020_pq = clamp(vec3(
            y + 1.4746 * cr,
            y - 0.16455 * cb - 0.57135 * cr,
            y + 1.8814 * cb), 0.0, 1.0);

        if ((pc.flags & YUV_TO_RGBA_PRESERVE_PQ) != 0u) {
            imageStore(out_img, ivec2(coord), vec4(rgb2020_pq, 1.0));
            return;
        }

        vec3 rgb2020_linear = vec3(
            tonemap_nits(pq_to_nits(rgb2020_pq.r)),
            tonemap_nits(pq_to_nits(rgb2020_pq.g)),
            tonemap_nits(pq_to_nits(rgb2020_pq.b)));

        vec3 rgb709_linear = clamp(vec3(
             1.6605 * rgb2020_linear.r - 0.5876 * rgb2020_linear.g - 0.0728 * rgb2020_linear.b,
            -0.1246 * rgb2020_linear.r + 1.1329 * rgb2020_linear.g - 0.0083 * rgb2020_linear.b,
            -0.0182 * rgb2020_linear.r - 0.1006 * rgb2020_linear.g + 1.1187 * rgb2020_linear.b),
            0.0, 1.0);

        float R = linear_to_srgb(rgb709_linear.r);
        float G = linear_to_srgb(rgb709_linear.g);
        float B = linear_to_srgb(rgb709_linear.b);

        imageStore(out_img, ivec2(coord), vec4(R, G, B, 1.0));
    } else if (pc.format == 1u) {
        /* NV12: 8-bit samples, UV order, BT.601 */
        uint y_byte_idx = coord.y * pc.y_stride + coord.x;
        uint y_word = yuv_buf.data[y_byte_idx >> 2];
        Y = unpack_byte(y_word, y_byte_idx & 3u);

        uint uv_row = coord.y >> 1;
        uint uv_col = (coord.x >> 1) * 2u;
        uint uv_byte_idx = pc.uv_offset + uv_row * pc.uv_stride + uv_col;
        uint uv_word = yuv_buf.data[uv_byte_idx >> 2];
        U = unpack_byte(uv_word, uv_byte_idx & 3u) - 128.0;
        V = unpack_byte(uv_word, (uv_byte_idx + 1u) & 3u) - 128.0;

        float R = Y + 1.402 * V;
        float G = Y - 0.344136 * U - 0.714136 * V;
        float B = Y + 1.772 * U;

        R = clamp(R, 0.0, 255.0) / 255.0;
        G = clamp(G, 0.0, 255.0) / 255.0;
        B = clamp(B, 0.0, 255.0) / 255.0;

        imageStore(out_img, ivec2(coord), vec4(R, G, B, 1.0));
    } else {
        /* NV21: 8-bit samples, VU order, BT.601 */
        uint y_byte_idx = coord.y * pc.y_stride + coord.x;
        uint y_word = yuv_buf.data[y_byte_idx >> 2];
        Y = unpack_byte(y_word, y_byte_idx & 3u);

        uint uv_row = coord.y >> 1;
        uint uv_col = (coord.x >> 1) * 2u;
        uint uv_byte_idx = pc.uv_offset + uv_row * pc.uv_stride + uv_col;
        uint uv_word = yuv_buf.data[uv_byte_idx >> 2];
        V = unpack_byte(uv_word, uv_byte_idx & 3u) - 128.0;
        U = unpack_byte(uv_word, (uv_byte_idx + 1u) & 3u) - 128.0;

        float R = Y + 1.402 * V;
        float G = Y - 0.344136 * U - 0.714136 * V;
        float B = Y + 1.772 * U;

        R = clamp(R, 0.0, 255.0) / 255.0;
        G = clamp(G, 0.0, 255.0) / 255.0;
        B = clamp(B, 0.0, 255.0) / 255.0;

        imageStore(out_img, ivec2(coord), vec4(R, G, B, 1.0));
    }
}
