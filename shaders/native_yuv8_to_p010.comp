#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer SrcYUV8 {
    uint data[];
} src;
layout(set = 0, binding = 1, r16) uniform image2D y_img;
layout(set = 0, binding = 2, rg16) uniform image2D uv_img;

layout(push_constant) uniform PushConstants {
    uint canvas_width;
    uint canvas_height;
    int dst_x;
    int dst_y;
    uint dst_w;
    uint dst_h;
    uint src_w;
    uint src_h;
    float opacity;
    uint flags;
    uint y_stride;
    uint uv_stride;
    uint uv_offset;
    float y_scale_x;
    float y_scale_y;
    float uv_scale_x;
    float uv_scale_y;
    float bg_y;
    float bg_u;
    float bg_v;
    uint filter_flags;
    float hdr_to_sdr_amount;
    float hdr_saturation;
    float hdr_brightness;
    float hdr_hue_cos;
    float hdr_hue_sin;
    float filter_params[4];
    uint src_offset_x;
    uint src_offset_y;
} pc;

const uint FLAG_FULL_CANVAS = 1u;
const uint FLAG_SOURCE_NV21 = 4u;
const uint FLAG_DST_IN_BOUNDS = 8u;
const uint FLAG_SOURCE_DRIVEN = 64u;
const uint FLAG_ROTATION_SHIFT = 8u;
const uint FLAG_FLIP_HORIZONTAL = 1u << 10u;
const uint FLAG_FLIP_VERTICAL = 1u << 11u;
const uint FILTER_HDR_TO_SDR = 32u;
const uint FILTER_SDR_TO_HDR = 1024u;
const float HDR_Y_OFFSET = 64.0 / 1023.0;
const float HDR_Y_SCALE = 876.0 / (1023.0 * 255.0);
const float HDR_UV_OFFSET = 64.0 / 1023.0;
const float HDR_UV_SCALE = 896.0 / (1023.0 * 255.0);
const vec3 HDR_RGB_TO_Y = vec3(0.2627, 0.6780, 0.0593);
const vec3 HDR_RGB_TO_CB = vec3(-0.1396, -0.3604, 0.5);
const vec3 HDR_RGB_TO_CR = vec3(0.5, -0.4598, -0.0402);

uint read_u8(uint byte_addr);

bool source_is_nv21() { return (pc.flags & FLAG_SOURCE_NV21) != 0u; }
bool dst_in_bounds() { return (pc.flags & FLAG_DST_IN_BOUNDS) != 0u; }
bool filter_hdr_to_sdr() { return (pc.filter_flags & FILTER_HDR_TO_SDR) != 0u; }
bool filter_sdr_to_hdr() { return (pc.filter_flags & FILTER_SDR_TO_HDR) != 0u; }
bool source_driven_enabled() { return (pc.flags & FLAG_SOURCE_DRIVEN) != 0u; }
uint rotation_quadrant() { return (pc.flags >> FLAG_ROTATION_SHIFT) & 3u; }
bool flip_horizontal() { return (pc.flags & FLAG_FLIP_HORIZONTAL) != 0u; }
bool flip_vertical() { return (pc.flags & FLAG_FLIP_VERTICAL) != 0u; }

float hdr_filter_amount() {
    if (filter_sdr_to_hdr()) return clamp(pc.hdr_to_sdr_amount, 0.0, 2.0);
    if (filter_hdr_to_sdr()) return clamp(pc.hdr_to_sdr_amount, 0.0, 1.0);
    return 0.0;
}

float bt709_to_linear(float v) {
    v = clamp(v, 0.0, 1.0);
    return v < 0.081 ? v / 4.5 : pow((v + 0.099) / 1.099, 1.0 / 0.45);
}

vec3 bt709_signal_to_bt2020_signal(vec3 v) {
    return clamp(vec3(
        0.6274 * v.r + 0.3293 * v.g + 0.0433 * v.b,
        0.0691 * v.r + 0.9195 * v.g + 0.0114 * v.b,
        0.0164 * v.r + 0.0880 * v.g + 0.8956 * v.b),
        0.0, 1.0);
}

float nits_to_pq(float nits) {
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    float p = pow(clamp(nits / 10000.0, 0.0, 1.0), m1);
    return pow((c1 + c2 * p) / (1.0 + c3 * p), m2);
}

float sdr_shadow_lift(float y, float over) {
    return mix(0.010, 0.006, over) *
        (1.0 - smoothstep(0.02, 0.30, clamp(y, 0.0, 1.0)));
}

float sdr_highlight_scale(float y, float over) {
    float t = smoothstep(0.68, 0.98, clamp(y, 0.0, 1.0));
    return mix(1.0, mix(0.68, 0.78, over), t);
}

float sdr_midtone_contrast(float pq, float y, float over) {
    float weight = smoothstep(0.18, 0.42, clamp(y, 0.0, 1.0)) *
        (1.0 - smoothstep(0.72, 0.90, clamp(y, 0.0, 1.0)));
    float contrast = 1.0 + 0.035 * weight * mix(1.0, 0.75, over);
    float pivot = mix(0.420, 0.445, over);
    return pivot + (pq - pivot) * contrast;
}

float sdr_to_hdr_luma(float y, float amount) {
    float over = clamp(amount - 1.0, 0.0, 1.0);
    float white_nits = mix(160.0, 240.0, over);
    float pq = nits_to_pq(bt709_to_linear(y) * white_nits * sdr_highlight_scale(y, over));
    pq = sdr_midtone_contrast(pq, y, over);
    pq += sdr_shadow_lift(y, over);
    pq += clamp(pc.hdr_brightness, -0.3, 0.3) * amount * 0.5;
    return clamp(pq, 0.0, 1.0);
}

float tone_map_y8_value(float y8) {
    float amount = hdr_filter_amount();
    if (amount <= 0.0) return y8;

    if (filter_sdr_to_hdr()) {
        float y = clamp((y8 - 16.0) / 219.0, 0.0, 1.0);
        return mix(y8, sdr_to_hdr_luma(y, amount) * 255.0, min(amount, 1.0));
    }

    float contrast = mix(1.0, 1.35, amount);
    float lift = mix(0.0, clamp(pc.hdr_brightness, -0.3, 0.3) * 255.0, amount);
    return clamp((y8 - 128.0) * contrast + 128.0 + lift, 0.0, 255.0);
}

vec2 rotate_chroma(vec2 cbcr) {
    return vec2(
        cbcr.x * pc.hdr_hue_cos - cbcr.y * pc.hdr_hue_sin,
        cbcr.x * pc.hdr_hue_sin + cbcr.y * pc.hdr_hue_cos);
}

vec2 read_uv8_pair(uint src_uv_x, uint src_uv_y) {
    uint uv_addr = pc.uv_offset + src_uv_y * pc.uv_stride + src_uv_x * 2u;
    float a = float(read_u8(uv_addr));
    float b = float(read_u8(uv_addr + 1u));
    return source_is_nv21() ? vec2(b, a) : vec2(a, b);
}

vec3 sdr_yuv8_to_bt2020_signal(float y8, vec2 uv8) {
    float amount = hdr_filter_amount();
    float over = clamp(amount - 1.0, 0.0, 1.0);
    float y = clamp((y8 - 16.0) / 219.0, 0.0, 1.0);
    vec2 cbcr = vec2((uv8.x - 128.0) / 224.0, (uv8.y - 128.0) / 224.0);
    float saturation = clamp(pc.hdr_saturation, 0.5, 2.5) * mix(1.0, 1.08, over);
    cbcr = rotate_chroma(cbcr * saturation);
    vec3 rgb709 = clamp(vec3(
        y + 1.5748 * cbcr.y,
        y - 0.1873 * cbcr.x - 0.4681 * cbcr.y,
        y + 1.8556 * cbcr.x),
        0.0, 1.0);
    return bt709_signal_to_bt2020_signal(rgb709);
}

float hdr_y_from_rgb(vec3 rgb) {
    return clamp(HDR_Y_OFFSET + dot(rgb, HDR_RGB_TO_Y) * (876.0 / 1023.0), 0.0, 1.0);
}

vec2 hdr_uv_from_rgb(vec3 rgb) {
    return vec2(
        clamp(HDR_UV_OFFSET + (dot(rgb, HDR_RGB_TO_CB) + 0.5) * (896.0 / 1023.0), 0.0, 1.0),
        clamp(HDR_UV_OFFSET + (dot(rgb, HDR_RGB_TO_CR) + 0.5) * (896.0 / 1023.0), 0.0, 1.0));
}

vec2 tone_map_uv8_values(vec2 uv8) {
    float amount = hdr_filter_amount();
    if (amount <= 0.0) return uv8;

    vec2 cbcr = uv8 - vec2(128.0);
    if (filter_sdr_to_hdr()) {
        float over = clamp(amount - 1.0, 0.0, 1.0);
        float target_sat = clamp(pc.hdr_saturation, 0.5, 2.5) * mix(1.0, 1.08, over);
        vec2 adjusted = rotate_chroma(cbcr * target_sat);
        return clamp(vec2(128.0) + mix(cbcr, adjusted, min(amount, 1.0)), 0.0, 255.0);
    }

    float target_sat = clamp(pc.hdr_saturation, 0.0, 3.0);
    vec2 adjusted = rotate_chroma(cbcr * target_sat);
    return clamp(vec2(128.0) + mix(cbcr, adjusted, amount), 0.0, 255.0);
}

uint read_u8(uint byte_addr) {
    uint word = src.data[byte_addr >> 2];
    return (word >> ((byte_addr & 3u) * 8u)) & 0xFFu;
}

float sample_sdr_to_hdr_y_src(uint src_x, uint src_y) {
    float y8 = float(read_u8(src_y * pc.y_stride + src_x));
    float y = clamp((y8 - 16.0) / 219.0, 0.0, 1.0);
    return clamp(HDR_Y_OFFSET + sdr_to_hdr_luma(y, hdr_filter_amount()) * (876.0 / 1023.0), 0.0, 1.0);
}

vec2 sample_sdr_to_hdr_uv_src(uint src_uv_x, uint src_uv_y) {
    vec2 uv = read_uv8_pair(src_uv_x, src_uv_y);
    uint src_x0 = min(src_uv_x * 2u, pc.src_w - 1u);
    uint src_x1 = min(src_x0 + 1u, pc.src_w - 1u);
    uint src_y0 = min(src_uv_y * 2u, pc.src_h - 1u);
    uint src_y1 = min(src_y0 + 1u, pc.src_h - 1u);
    vec3 rgb = (
        sdr_yuv8_to_bt2020_signal(float(read_u8(src_y0 * pc.y_stride + src_x0)), uv) +
        sdr_yuv8_to_bt2020_signal(float(read_u8(src_y0 * pc.y_stride + src_x1)), uv) +
        sdr_yuv8_to_bt2020_signal(float(read_u8(src_y1 * pc.y_stride + src_x0)), uv) +
        sdr_yuv8_to_bt2020_signal(float(read_u8(src_y1 * pc.y_stride + src_x1)), uv)) * 0.25;
    return hdr_uv_from_rgb(rgb);
}

uint scale_nearest(uint pos, uint src_extent, float scale) {
    if (src_extent <= 1u) return 0u;
    float f = (float(pos) + 0.5) * scale;
    uint v = uint(f);
    return min(v, src_extent - 1u);
}

uint rotated_local_x(uint local_x, uint local_y) {
    uint rot = rotation_quadrant();
    if (rot == 1u) return local_y;
    if (rot == 2u) return pc.dst_w > 0u ? pc.dst_w - 1u - min(local_x, pc.dst_w - 1u) : 0u;
    if (rot == 3u) return pc.dst_h > 0u ? pc.dst_h - 1u - min(local_y, pc.dst_h - 1u) : 0u;
    return local_x;
}

uint rotated_local_y(uint local_x, uint local_y) {
    uint rot = rotation_quadrant();
    if (rot == 1u) return pc.dst_w > 0u ? pc.dst_w - 1u - min(local_x, pc.dst_w - 1u) : 0u;
    if (rot == 2u) return pc.dst_h > 0u ? pc.dst_h - 1u - min(local_y, pc.dst_h - 1u) : 0u;
    if (rot == 3u) return local_x;
    return local_y;
}

uint source_extent_x() {
    return (rotation_quadrant() & 1u) != 0u ? pc.dst_h : pc.dst_w;
}

uint source_extent_y() {
    return (rotation_quadrant() & 1u) != 0u ? pc.dst_w : pc.dst_h;
}

float source_scale_x() {
    return float(pc.src_w) / float(max(source_extent_x(), 1u));
}

float source_scale_y() {
    return float(pc.src_h) / float(max(source_extent_y(), 1u));
}

uint flipped_source_x(uint x) {
    uint extent = max(source_extent_x(), 1u);
    x = min(x, extent - 1u);
    return flip_horizontal() ? extent - 1u - x : x;
}

uint flipped_source_y(uint y) {
    uint extent = max(source_extent_y(), 1u);
    y = min(y, extent - 1u);
    return flip_vertical() ? extent - 1u - y : y;
}

uint source_x(uint local_x, uint local_y) {
    return pc.src_offset_x + scale_nearest(flipped_source_x(rotated_local_x(local_x, local_y)), pc.src_w, source_scale_x());
}

uint source_y(uint local_x, uint local_y) {
    return pc.src_offset_y + scale_nearest(flipped_source_y(rotated_local_y(local_x, local_y)), pc.src_h, source_scale_y());
}

uint source_uv_x(uint local_uv_x, uint local_uv_y) {
    uint local_x = min(local_uv_x * 2u + 1u, pc.dst_w - 1u);
    uint local_y = min(local_uv_y * 2u + 1u, pc.dst_h - 1u);
    return source_x(local_x, local_y) >> 1;
}

uint source_uv_y(uint local_uv_x, uint local_uv_y) {
    uint local_x = min(local_uv_x * 2u + 1u, pc.dst_w - 1u);
    uint local_y = min(local_uv_y * 2u + 1u, pc.dst_h - 1u);
    return source_y(local_x, local_y) >> 1;
}

uint out_begin_for_src(uint s, float inv_scale) {
    return uint(max(ceil(float(s) * inv_scale - 0.5), 0.0));
}

uint out_end_for_src(uint s, float inv_scale, uint limit) {
    float end_f = ceil(float(s + 1u) * inv_scale - 0.5);
    return uint(clamp(end_f, 0.0, float(limit)));
}

float sample_hdr_y(uint local_x, uint local_y) {
    uint src_x = source_x(local_x, local_y);
    uint src_y = source_y(local_x, local_y);
    if (filter_sdr_to_hdr() && hdr_filter_amount() > 0.0)
        return sample_sdr_to_hdr_y_src(src_x, src_y);
    return HDR_Y_OFFSET + tone_map_y8_value(float(read_u8(src_y * pc.y_stride + src_x))) * HDR_Y_SCALE;
}

float sample_hdr_y_src(uint src_x, uint src_y) {
    if (filter_sdr_to_hdr() && hdr_filter_amount() > 0.0)
        return sample_sdr_to_hdr_y_src(src_x, src_y);
    return HDR_Y_OFFSET + tone_map_y8_value(float(read_u8(src_y * pc.y_stride + src_x))) * HDR_Y_SCALE;
}

vec2 sample_hdr_uv(uint local_uv_x, uint local_uv_y) {
    /* Fast overlay path: map 8-bit YUV ranges into P010 without an RGB round-trip. */
    uint src_uv_x = source_uv_x(local_uv_x, local_uv_y);
    uint src_uv_y = source_uv_y(local_uv_x, local_uv_y);
    if (filter_sdr_to_hdr() && hdr_filter_amount() > 0.0)
        return sample_sdr_to_hdr_uv_src(src_uv_x, src_uv_y);
    return HDR_UV_OFFSET + tone_map_uv8_values(read_uv8_pair(src_uv_x, src_uv_y)) * HDR_UV_SCALE;
}

vec2 sample_hdr_uv_src(uint src_uv_x, uint src_uv_y) {
    if (filter_sdr_to_hdr() && hdr_filter_amount() > 0.0)
        return sample_sdr_to_hdr_uv_src(src_uv_x, src_uv_y);
    return HDR_UV_OFFSET + tone_map_uv8_values(read_uv8_pair(src_uv_x, src_uv_y)) * HDR_UV_SCALE;
}

void write_luma_rect(uint src_x, uint src_y, float y) {
    float inv_x = 1.0 / pc.y_scale_x;
    float inv_y = 1.0 / pc.y_scale_y;
    uint lx0 = out_begin_for_src(src_x, inv_x);
    uint lx1 = out_end_for_src(src_x, inv_x, pc.dst_w);
    uint ly0 = out_begin_for_src(src_y, inv_y);
    uint ly1 = out_end_for_src(src_y, inv_y, pc.dst_h);

    int visible_lx0 = max(int(lx0), -pc.dst_x);
    int visible_lx1 = min(int(lx1), int(pc.canvas_width) - pc.dst_x);
    int visible_ly0 = max(int(ly0), -pc.dst_y);
    int visible_ly1 = min(int(ly1), int(pc.canvas_height) - pc.dst_y);
    if (visible_lx1 <= visible_lx0 || visible_ly1 <= visible_ly0)
        return;

    for (int ly = visible_ly0; ly < visible_ly1; ly++) {
        int dy = pc.dst_y + ly;
        for (int lx = visible_lx0; lx < visible_lx1; lx++)
            imageStore(y_img, ivec2(pc.dst_x + lx, dy), vec4(y, 0.0, 0.0, 1.0));
    }
}

void write_chroma_rect(uint src_uv_x, uint src_uv_y, vec2 uv) {
    uint dst_uv_w = max((pc.dst_w + 1u) >> 1, 1u);
    uint dst_uv_h = max((pc.dst_h + 1u) >> 1, 1u);
    float inv_x = 1.0 / pc.uv_scale_x;
    float inv_y = 1.0 / pc.uv_scale_y;
    uint ux0 = out_begin_for_src(src_uv_x, inv_x);
    uint ux1 = out_end_for_src(src_uv_x, inv_x, dst_uv_w);
    uint uy0 = out_begin_for_src(src_uv_y, inv_y);
    uint uy1 = out_end_for_src(src_uv_y, inv_y, dst_uv_h);

    int dst_uv_x = pc.dst_x >> 1;
    int dst_uv_y = pc.dst_y >> 1;
    int visible_ux0 = max(int(ux0), -dst_uv_x);
    int visible_ux1 = min(int(ux1), int(pc.canvas_width >> 1) - dst_uv_x);
    int visible_uy0 = max(int(uy0), -dst_uv_y);
    int visible_uy1 = min(int(uy1), int(pc.canvas_height >> 1) - dst_uv_y);
    if (visible_ux1 <= visible_ux0 || visible_uy1 <= visible_uy0)
        return;

    for (int uy = visible_uy0; uy < visible_uy1; uy++) {
        int dy = dst_uv_y + uy;
        for (int ux = visible_ux0; ux < visible_ux1; ux++)
            imageStore(uv_img, ivec2(dst_uv_x + ux, dy), vec4(uv, 0.0, 1.0));
    }
}

void render_source_driven() {
    uint local_pair = gl_GlobalInvocationID.x;
    uint src_y = gl_GlobalInvocationID.y;
    uint pair_start = pc.src_offset_x;
    uint pair_count = pc.src_offset_y;
    if (local_pair >= pair_count || src_y >= pc.src_h)
        return;

    uint pair_x = pair_start + local_pair;
    uint src_uv_w = max((pc.src_w + 1u) >> 1, 1u);
    if (pair_x >= src_uv_w)
        return;

    uint x0 = pair_x * 2u;
    uint x1 = min(x0 + 1u, pc.src_w - 1u);
    write_luma_rect(x0, src_y, sample_hdr_y_src(x0, src_y));
    if (x1 != x0)
        write_luma_rect(x1, src_y, sample_hdr_y_src(x1, src_y));

    if ((src_y & 1u) == 0u) {
        uint src_uv_y = src_y >> 1;
        write_chroma_rect(pair_x, src_uv_y, sample_hdr_uv_src(pair_x, src_uv_y));
    }
}

void main() {
    if (source_driven_enabled()) {
        render_source_driven();
        return;
    }

    bool full_canvas = (pc.flags & FLAG_FULL_CANVAS) != 0u;
    uvec2 base = gl_GlobalInvocationID.xy * 2u;
    uint limit_w = full_canvas ? pc.canvas_width : pc.dst_w;
    uint limit_h = full_canvas ? pc.canvas_height : pc.dst_h;
    if (base.x >= limit_w || base.y >= limit_h) return;

    ivec2 dst_base = full_canvas
        ? ivec2(int(base.x), int(base.y))
        : ivec2(pc.dst_x + int(base.x), pc.dst_y + int(base.y));

    if (rotation_quadrant() == 0u && !full_canvas && pc.opacity >= 0.999 && dst_in_bounds()) {
        uint x0 = base.x;
        uint y0 = base.y;
        uint x1 = min(base.x + 1u, limit_w - 1u);
        uint y1 = min(base.y + 1u, limit_h - 1u);
        uint src_x0 = source_x(x0, y0);
        uint src_x1 = source_x(x1, y0);
        uint src_y0 = source_y(x0, y0);
        uint src_y1 = source_y(x0, y1);
        ivec2 dst = dst_base;

        float y00 = sample_hdr_y_src(src_x0, src_y0);
        imageStore(y_img, dst, vec4(y00, 0.0, 0.0, 1.0));

        if (base.x + 1u < limit_w) {
            float y10 = sample_hdr_y_src(src_x1, src_y0);
            imageStore(y_img, dst + ivec2(1, 0), vec4(y10, 0.0, 0.0, 1.0));
        }
        if (base.y + 1u < limit_h) {
            float y01 = sample_hdr_y_src(src_x0, src_y1);
            imageStore(y_img, dst + ivec2(0, 1), vec4(y01, 0.0, 0.0, 1.0));
            if (base.x + 1u < limit_w) {
                float y11 = sample_hdr_y_src(src_x1, src_y1);
                imageStore(y_img, dst + ivec2(1, 1), vec4(y11, 0.0, 0.0, 1.0));
            }
        }

        vec2 uv = sample_hdr_uv(base.x >> 1, base.y >> 1);
        imageStore(uv_img, dst_base >> 1, vec4(uv, 0.0, 1.0));
        return;
    }

    if (!full_canvas && pc.opacity >= 0.999) {
        for (uint yy = 0u; yy < 2u; yy++) {
            uint pos_y = base.y + yy;
            if (pos_y >= limit_h) continue;

            for (uint xx = 0u; xx < 2u; xx++) {
                uint pos_x = base.x + xx;
                if (pos_x >= limit_w) continue;

                ivec2 dst = ivec2(pc.dst_x + int(pos_x), pc.dst_y + int(pos_y));
                if (dst.x < 0 || dst.y < 0 ||
                    dst.x >= int(pc.canvas_width) || dst.y >= int(pc.canvas_height)) continue;

                imageStore(y_img, dst, vec4(sample_hdr_y(pos_x, pos_y), 0.0, 0.0, 1.0));
            }
        }

        ivec2 uv_dst = dst_base >> 1;
        if (uv_dst.x >= 0 && uv_dst.y >= 0 &&
            uv_dst.x < int(pc.canvas_width >> 1) &&
            uv_dst.y < int(pc.canvas_height >> 1) &&
            dst_base.x >= 0 && dst_base.y >= 0 &&
            dst_base.x < int(pc.canvas_width) && dst_base.y < int(pc.canvas_height)) {
            vec2 uv = sample_hdr_uv(base.x >> 1, base.y >> 1);
            imageStore(uv_img, uv_dst, vec4(uv, 0.0, 1.0));
        }
        return;
    }

    for (uint yy = 0u; yy < 2u; yy++) {
        uint pos_y = base.y + yy;
        if (pos_y >= limit_h) continue;

        for (uint xx = 0u; xx < 2u; xx++) {
            uint pos_x = base.x + xx;
            if (pos_x >= limit_w) continue;

            ivec2 dst = full_canvas
                ? ivec2(int(pos_x), int(pos_y))
                : ivec2(pc.dst_x + int(pos_x), pc.dst_y + int(pos_y));
            if (dst.x < 0 || dst.y < 0 ||
                dst.x >= int(pc.canvas_width) || dst.y >= int(pc.canvas_height)) continue;

            bool inside = true;
            uint local_x = pos_x;
            uint local_y = pos_y;
            if (full_canvas) {
                inside = dst.x >= pc.dst_x && dst.y >= pc.dst_y &&
                         dst.x < pc.dst_x + int(pc.dst_w) &&
                         dst.y < pc.dst_y + int(pc.dst_h);
                if (inside) {
                    local_x = uint(dst.x - pc.dst_x);
                    local_y = uint(dst.y - pc.dst_y);
                }
            }

            float y = inside ? sample_hdr_y(local_x, local_y) : pc.bg_y;
            if (pc.opacity >= 0.999) {
                imageStore(y_img, dst, vec4(y, 0.0, 0.0, 1.0));
            } else {
                float old_y = imageLoad(y_img, dst).r;
                imageStore(y_img, dst, vec4(mix(old_y, y, pc.opacity), 0.0, 0.0, 1.0));
            }
        }
    }

    ivec2 uv_dst = full_canvas ? ivec2(int(base.x >> 1), int(base.y >> 1))
                               : (dst_base >> 1);
    if (uv_dst.x >= 0 && uv_dst.y >= 0 &&
        uv_dst.x < int(pc.canvas_width >> 1) &&
        uv_dst.y < int(pc.canvas_height >> 1) &&
        (full_canvas || (dst_base.x >= 0 && dst_base.y >= 0 &&
         dst_base.x < int(pc.canvas_width) && dst_base.y < int(pc.canvas_height)))) {
        bool uv_inside = true;
        uint local_uv_x = base.x >> 1;
        uint local_uv_y = base.y >> 1;
        if (full_canvas) {
            ivec2 uv_sample = ivec2(int(base.x + 1u), int(base.y + 1u));
            uv_inside = uv_sample.x >= pc.dst_x && uv_sample.y >= pc.dst_y &&
                        uv_sample.x < pc.dst_x + int(pc.dst_w) &&
                        uv_sample.y < pc.dst_y + int(pc.dst_h);
            if (uv_inside) {
                local_uv_x = uint(uv_sample.x - pc.dst_x) >> 1;
                local_uv_y = uint(uv_sample.y - pc.dst_y) >> 1;
            }
        }

        vec2 uv = uv_inside ? sample_hdr_uv(local_uv_x, local_uv_y)
                            : vec2(pc.bg_u, pc.bg_v);
        if (pc.opacity >= 0.999) {
            imageStore(uv_img, uv_dst, vec4(uv, 0.0, 1.0));
        } else {
            vec2 old_uv = imageLoad(uv_img, uv_dst).rg;
            imageStore(uv_img, uv_dst, vec4(mix(old_uv, uv, pc.opacity), 0.0, 1.0));
        }
    }
}
